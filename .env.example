# Environment Variables for JobPilot AI
# Copy this file to .env.local and fill in all values
# NEVER commit .env.local to git

# DATABASE (Neon PostgreSQL)
DATABASE_URL="postgresql://user:password@host/jobpilot?sslmode=require"

# AUTH (NextAuth v5)
AUTH_SECRET="generate-with: openssl rand -base64 32"
AUTH_URL="http://localhost:3000"

# AI (OpenAI)
OPENAI_API_KEY="sk-..."
OPENAI_ORG_ID=""

# FILE STORAGE (Supabase)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
SUPABASE_STORAGE_BUCKET="jobpilot-files"

# EMAIL (Resend)
RESEND_API_KEY="re_..."
EMAIL_FROM="JobPilot AI <noreply@yourdomain.com>"

# BACKGROUND JOBS (Inngest)
INNGEST_EVENT_KEY="your-inngest-event-key"
INNGEST_SIGNING_KEY="your-inngest-signing-key"

# CACHING / RATE LIMITING (Upstash Redis)
UPSTASH_REDIS_REST_URL="https://your-instance.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-token"

# APP CONFIG
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="JobPilot AI"
NODE_ENV="development"
