generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String           @id @default(cuid())
  name             String?
  email            String           @unique
  emailVerified    DateTime?
  image            String?
  password         String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  accounts         Account[]
  sessions         Session[]
  profile          Profile?
  resumes          Resume[]
  jobs             Job[]
  applications     Application[]
  notifications    Notification[]
  jobAlerts        JobAlert[]
  companies        Company[]
  skillGaps        SkillGap[]
  autoApplyConfig  AutoApplyConfig?
  autoApplyJobs    AutoApplyJob[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Profile {
  id                  String           @id @default(cuid())
  userId              String           @unique
  user                User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone               String?
  location            String?
  linkedinUrl         String?
  githubUrl           String?
  portfolioUrl        String?
  websiteUrl          String?
  headline            String?
  bio                 String?          @db.Text
  currentRole         String?
  yearsExperience     Int?
  employmentTypes     EmploymentType[]
  preferredLocations  String[]
  remotePreference    RemotePreference @default(OPEN)
  salaryMin           Int?
  salaryMax           Int?
  salaryCurrency      String           @default("INR")
  noticePeriod        String?
  availability        String?
  targetRoles         String[]
  excludedRoles       String[]
  excludedLocations   String[]
  excludedKeywords    String[]
  priorityKeywords    String[]
  minMatchScore       Int              @default(70)
  educationLevel      String?
  profileCompleteness Int              @default(0)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  skills              Skill[]
  education           Education[]
  certifications      Certification[]
  targetCompanies     TargetCompany[]

  @@map("profiles")
}

model Skill {
  id          String        @id @default(cuid())
  profileId   String
  profile     Profile       @relation(fields: [profileId], references: [id], onDelete: Cascade)
  name        String
  category    SkillCategory @default(OTHER)
  proficiency SkillLevel    @default(INTERMEDIATE)
  yearsUsed   Int?

  @@unique([profileId, name])
  @@map("skills")
}

model Education {
  id          String    @id @default(cuid())
  profileId   String
  profile     Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  institution String
  degree      String
  field       String?
  startYear   Int?
  endYear     Int?
  grade       String?

  @@map("education")
}

model Certification {
  id        String    @id @default(cuid())
  profileId String
  profile   Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  name      String
  issuer    String
  issueDate DateTime?
  expiryDate DateTime?
  credentialId String?
  url       String?

  @@map("certifications")
}

model TargetCompany {
  id        String           @id @default(cuid())
  profileId String
  profile   Profile          @relation(fields: [profileId], references: [id], onDelete: Cascade)
  name      String
  sentiment CompanySentiment @default(NEUTRAL)
  notes     String?          @db.Text

  @@unique([profileId, name])
  @@map("target_companies")
}

model Resume {
  id             String        @id @default(cuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  resumeType     ResumeType    @default(MASTER)
  parentId       String?
  parent         Resume?       @relation("ResumeVersions", fields: [parentId], references: [id])
  versions       Resume[]      @relation("ResumeVersions")
  fileUrl        String?
  fileType       String?
  fileName       String?
  summary        String?       @db.Text
  skills         Json?
  experience     Json?
  projects       Json?
  education      Json?
  certifications Json?
  achievements   Json?
  rawText        String?       @db.Text
  isActive       Boolean       @default(true)
  targetRole     String?
  atsScore       Int?
  wordCount      Int?
  description    String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  applications   Application[]
  autoApplyJobs  AutoApplyJob[]

  @@index([userId])
  @@map("resumes")
}

model Company {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  website     String?
  industry    String?
  size        String?
  location    String?
  description String?  @db.Text
  logoUrl     String?
  notes       String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  jobs        Job[]

  @@unique([userId, name])
  @@map("companies")
}

model Job {
  id                 String         @id @default(cuid())
  userId             String
  user               User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId          String?
  company            Company?       @relation(fields: [companyId], references: [id])
  title              String
  companyName        String
  location           String?
  remoteType         RemoteType     @default(UNSPECIFIED)
  employmentType     EmploymentType @default(FULL_TIME)
  rawDescription     String?        @db.Text
  description        String?        @db.Text
  requiredSkills     String[]
  preferredSkills    String[]
  responsibilities   String[]
  experienceRequired String?
  educationRequired  String?
  salaryMin          Int?
  salaryMax          Int?
  salaryCurrency     String         @default("INR")
  salaryText         String?
  benefits           String[]
  source             JobSource      @default(MANUAL)
  sourceUrl          String?
  sourceJobId        String?
  applicationUrl     String?
  contentHash        String?
  isDuplicate        Boolean        @default(false)
  duplicateOfId      String?
  isFiltered         Boolean        @default(false)
  filterReason       String?
  freshness          FreshnessScore @default(FRESH)
  repostCount        Int            @default(0)
  datePosted         DateTime?
  dateDiscovered     DateTime       @default(now())
  expiresAt          DateTime?
  jobStatus          JobStatus      @default(NEW)
  isSaved            Boolean        @default(false)
  isSkipped          Boolean        @default(false)
  matchScore         Int?
  matchCategory      MatchCategory?
  aiAnalyzedAt       DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  aiAnalysis         AIAnalysis?
  sources            JobSourceRecord[]
  applications       Application[]
  autoApplyJobs      AutoApplyJob[]

  @@index([userId])
  @@index([userId, matchScore])
  @@index([userId, dateDiscovered])
  @@index([companyName, title])
  @@map("jobs")
}

model JobSourceRecord {
  id         String    @id @default(cuid())
  jobId      String
  job        Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  source     JobSource
  url        String?
  externalId String?
  rawPayload Json?
  scrapedAt  DateTime  @default(now())

  @@map("job_source_records")
}

model AIAnalysis {
  id                  String           @id @default(cuid())
  jobId               String           @unique
  job                 Job              @relation(fields: [jobId], references: [id], onDelete: Cascade)
  matchScore          Int
  technicalScore      Int
  experienceScore     Int
  roleScore           Int
  locationScore       Int
  salaryScore         Int
  growthScore         Int
  employmentTypeScore Int              @default(100)
  recommendation      AIRecommendation
  confidence          Float
  strengths           String[]
  missingSkills       String[]
  concerns            String[]
  matchedRequirements String[]
  unmatchedRequirements String[]
  suggestedResumeEdits String[]
  coverLetterKeyPoints String[]
  whyApply            String?          @db.Text
  analysisVersion     Int              @default(1)
  rawPrompt           String?          @db.Text
  rawResponse         String?          @db.Text
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@map("ai_analyses")
}

model Application {
  id               String            @id @default(cuid())
  userId           String
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId            String
  job              Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  resumeId         String?
  resume           Resume?           @relation(fields: [resumeId], references: [id])
  appStatus        ApplicationStatus @default(READY)
  appliedAt        DateTime?
  followUpDueAt    DateTime?
  followUpSent     Boolean           @default(false)
  followUpCount    Int               @default(0)
  notes            String?           @db.Text
  coverLetterText  String?           @db.Text
  tailoredResumeId String?
  tailoredSummary  String?           @db.Text
  tailoredSkills   Json?
  tailoredExp      Json?
  stageHistory     Json?
  contactName      String?
  contactEmail     String?
  contactRole      String?
  submissionProof  String?
  salaryOffered    Int?
  salaryCurrency   String            @default("INR")
  offerDeadline    DateTime?
  offerDetails     Json?
  rejectionReason  String?
  feedback         String?           @db.Text
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  events           ApplicationEvent[]
  interviews       Interview[]

  @@unique([userId, jobId])
  @@index([userId, appStatus])
  @@map("applications")
}

model ApplicationEvent {
  id            String   @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  eventType     String
  description   String
  metadata      Json?
  occurredAt    DateTime @default(now())

  @@map("application_events")
}

model Interview {
  id            String            @id @default(cuid())
  applicationId String
  application   Application       @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  interviewType InterviewType     @default(TECHNICAL)
  scheduledAt   DateTime
  durationMins  Int?
  interviewer   String?
  meetingLink   String?
  location      String?
  notes         String?           @db.Text
  prepNotes     String?           @db.Text
  outcome       InterviewOutcome  @default(PENDING)
  feedback      String?           @db.Text
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@map("interviews")
}

model JobAlert {
  id          String         @id @default(cuid())
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  keywords    String[]
  roles       String[]
  locations   String[]
  remoteTypes RemoteType[]
  salaryMin   Int?
  frequency   AlertFrequency @default(DAILY)
  isActive    Boolean        @default(true)
  lastSentAt  DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@map("job_alerts")
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  message   String           @db.Text
  data      Json?
  isRead    Boolean          @default(false)
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, isRead])
  @@map("notifications")
}

model SkillGap {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  skill      String
  frequency  Int
  percentage Float
  inProfile  Boolean  @default(false)
  category   String?
  computedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, skill])
  @@map("skill_gaps")
}

model AutoApplyConfig {
  id                String        @id @default(cuid())
  userId            String        @unique
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  isEnabled         Boolean       @default(false)
  mode              AutoApplyMode @default(SEMI_AUTONOMOUS)
  minMatchScore     Int           @default(80)
  maxDailyApplies   Int           @default(15)
  todayAppliedCount Int           @default(0)
  lastResetDate     DateTime      @default(now())
  enableLinkedIn    Boolean       @default(true)
  enableGreenhouse  Boolean       @default(true)
  enableLever       Boolean       @default(true)
  enableRemoteAPIs  Boolean       @default(true)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@map("auto_apply_configs")
}

model AutoApplyJob {
  id               String          @id @default(cuid())
  userId           String
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId            String
  job              Job             @relation(fields: [jobId], references: [id], onDelete: Cascade)
  status           AutoApplyStatus @default(QUEUED)
  tailoredResumeId String?
  tailoredResume   Resume?         @relation(fields: [tailoredResumeId], references: [id])
  coverLetterText  String?         @db.Text
  recruiterMessage String?         @db.Text
  interviewPrep    Json?
  screeningAnswers Json?
  errorMessage     String?
  screenshotUrl    String?
  submittedAt      DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([userId, status])
  @@map("auto_apply_jobs")
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  FREELANCE
  INTERNSHIP
}

enum RemoteType {
  REMOTE
  HYBRID
  ONSITE
  UNSPECIFIED
}

enum RemotePreference {
  REMOTE_ONLY
  HYBRID_PREFERRED
  OPEN
  ONSITE_PREFERRED
}

enum JobSource {
  MANUAL
  URL
  EMAIL_ALERT
  API
  LINKEDIN
  LINKEDIN_MANUAL
  NAUKRI
  NAUKRI_MANUAL
  GREENHOUSE
  LEVER
  ASHBY
  REMOTEOK
  HIMALAYAS
  WWR
  ARBEITNOW
}

enum FreshnessScore {
  FRESH
  STANDARD
  STALE_GHOST
}

enum AutoApplyStatus {
  QUEUED
  TAILORING
  READY_FOR_SUBMISSION
  SUBMITTING
  SUBMITTED
  FAILED
  FLAGGED_CAPTCHA
  MANUAL_REVIEW_REQUIRED
}

enum AutoApplyMode {
  SEMI_AUTONOMOUS
  FULL_AUTONOMOUS
}

enum JobStatus {
  NEW
  ANALYZED
  RECOMMENDED
  SAVED
  SKIPPED
  APPLIED
  EXPIRED
}

enum MatchCategory {
  EXCELLENT
  STRONG
  GOOD
  WEAK
  POOR
}

enum AIRecommendation {
  APPLY
  CONSIDER
  SKIP
}

enum ApplicationStatus {
  NEW
  REVIEW
  READY
  APPLIED
  SCREENING
  INTERVIEW
  OFFER
  REJECTED
  WITHDRAWN
}

enum ResumeType {
  MASTER
  TAILORED
  VARIANT
}

enum SkillCategory {
  LANGUAGE
  FRAMEWORK
  DATABASE
  CLOUD
  TOOL
  SOFT
  AI
  OTHER
}

enum SkillLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

enum InterviewType {
  PHONE_SCREEN
  TECHNICAL
  SYSTEM_DESIGN
  BEHAVIORAL
  ONSITE
  FINAL
}

enum InterviewOutcome {
  PASSED
  FAILED
  PENDING
  CANCELLED
}

enum CompanySentiment {
  PRIORITY
  NEUTRAL
  AVOID
}

enum AlertFrequency {
  DAILY
  TWICE_DAILY
  WEEKLY
}

enum NotificationType {
  NEW_MATCHES
  APPLICATION_READY
  FOLLOW_UP_DUE
  INTERVIEW_REMINDER
  STATUS_CHANGE
  SYSTEM
}